<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="350"
    x:Class="project_main.PrefPageColourScheme">
    
    <Border Name="MainBorder" Classes="PPCSBorder">
        <Grid Name="Main" Classes="PPCS" ColumnDefinitions="*,*,*,*,*">
            <Rectangle Name="PrimaryRect" Classes="PPCSRectangle" Grid.Column="0"/>
            <Rectangle Name="SecondaryRect" Classes="PPCSRectangle" Grid.Column="1"/>
            <Rectangle Name="TextRect" Classes="PPCSRectangle" Grid.Column="2"/>
            <Rectangle Name="AccentRect" Classes="PPCSRectangle" Grid.Column="3"/>
            <Button Classes="PPCSButton" Click="ButtonHandler"  Content="{Binding SelectButtonText}" Grid.Column="4"/>
        </Grid>
    </Border>

</UserControl>