<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="350"
    x:Class="project_main.GoalsPage">


    <Grid Name="GoalLogMain" Classes="GLMain" ColumnDefinitions="*,*">

        <Grid Name="GoalMainGrid" Classes="GoalMain" Grid.Column="0" RowDefinitions="*,*,*,5*,*">
            <TextBlock Name="GoalDesc" Classes="BLFontClass GoalText" Text="{Binding GoalDescText}" Grid.Row="0"/>
            <TextBlock Name="GoalCurrent" Classes="BLFontClass GoalText" Text="{Binding GoalDefault}" Grid.Row="1"/>
            <TextBlock Name="GoalError" Classes="BLFontClass GoalText GoalError" Grid.Row="2"/>
            <Grid Name="GoalMainBlock" Classes="GMBlock" Grid.Row="3" RowDefinitions="*,*">
                <DockPanel Name="GoalInputType" Classes="GoalInputDock" Grid.Row="0">
                    <TextBlock Name="GITypeText" Classes="BLFontClass GoalText" Text="{Binding TypeText}" DockPanel.Dock="Left"/>
                    <ComboBox Name="GITypeInput" Classes="GITypeCombo" DockPanel.Dock="Right"/>
                </DockPanel>
                <DockPanel Name="GoalInputMagnitude" Classes="GoalInputDock" Grid.Row="1">
                    <TextBlock Name="GIMagnitudeText" Classes="BLFontClass GoalText" Text="{Binding MagText}" DockPanel.Dock="Left"/>
                    <TextBox Name="GIMagnitudeInput" Classes="BOFontClass GIMagnitudeBox BasicTextBox" DockPanel.Dock="Right"/>
                </DockPanel>
            </Grid>
            <DockPanel Name="GoalButtonPanel" Classes="GMButtons" Grid.Row="4">
                <Button Name="GoalButtonClear" Classes="GoalButton" Click="TriggerRevertGoal" Content="{Binding GoalButtonClearText}" DockPanel.Dock="Left"/>
                <Button Name="GoalButtonUpdate" Classes="GoalButton" Click="TriggerUpdateGoal" Content="{Binding GoalButtonUpdateText}" DockPanel.Dock="Right"/>
            </DockPanel>
        </Grid>

        <Grid Name="LogMainGrid" Classes="LogMain" Grid.Column="1" RowDefinitions="3*,*">
            <Grid Name="LogStudy" Classes="LogStudy" Grid.Row="0" RowDefinitions="*,*,8*">
                <TextBlock Name="LogStudyText" Classes="LogTextHead BLFontClass" Text="{Binding LogStudyHeadText}" Grid.Row="0"/>
                <TextBlock Name="LogStudyErrorBlock" Classes="LogTextHead BLFontClass" Grid.Row="1"/>
                <Border Name="LSB" Classes="LSB" Grid.Row="2"><ScrollViewer Name="LogStudyScroll" Classes="LogStudyScroll"><DockPanel Name="LogStudyEvents" Classes="LogStudyEvents">
                </DockPanel></ScrollViewer></Border>
            </Grid>

            <Grid Name="LogSurplus" Classes="LogSurplus" Grid.Row="1" RowDefinitions="*,*">
                <TextBlock Name="LogSurplusText" Classes="LogTextHead BLFontClass" Text="{Binding LogSurplusHeadText}" Grid.Row="0"/>
                <Grid Name="LSAdd" Classes="LSAdd" ColumnDefinitions="*,2*,*" Grid.Row="1">
                    <TextBox Name="LSABox" Classes="BOFontClass LSABox BasicTextBox" Grid.Column="0"/>
                    <TextBlock Name="LSATextBlock" Classes="BLFontClass LSAText" Text="{Binding LSATextBinding}" Grid.Column="1"/>
                    <Button Name="LSASubmit" Classes="LSASubmitButton BUFontClass" Click="LogSurplusClick" Content="{Binding LSAButtonText}" Grid.Column="2"/>
                </Grid> 
            </Grid>
        </Grid>

    </Grid>

</UserControl>