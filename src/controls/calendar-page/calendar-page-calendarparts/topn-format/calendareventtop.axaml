<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="30" d:DesignHeight="20"
    x:Class="project_main.CalendarEventTop">

    <DockPanel Name="CETMain">
            <Button Name="CETButton" Classes="CETButton" Click="OnPress">
                <TextBlock Name="CETButtonText" Classes="CETButtonText BLFontClass"></TextBlock>
            </Button> 
    </DockPanel>

</UserControl>
