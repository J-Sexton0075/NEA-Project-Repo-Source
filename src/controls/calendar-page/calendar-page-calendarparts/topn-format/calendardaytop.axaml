<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
    x:Class="project_main.CalendarDayTop">
    <Border Name="CDTBorder" Classes="CDTBorder">
    <Grid Name="CDTMain" Classes="CDTPanel" RowDefinitions="20,*">
        
        <DockPanel Grid.Row="0" Name="CDTHeader" Classes="CDTHeader">
            <TextBlock Name="CDTTextHeader" Classes="CDTTextHeader BLFontClass"/>
        </DockPanel>
        <Grid Grid.Row="1" Name="CDTMainGrid" Classes="CDTGrid"> <!-- Will contain each of the elements. Dimensions are based on user inputs. -->
        
        </Grid>
        
    </Grid>
    </Border>
</UserControl>