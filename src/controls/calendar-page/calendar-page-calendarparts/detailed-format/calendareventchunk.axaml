<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="30" d:DesignHeight="20"
    x:Class="project_main.CalendarEventChunk">

    
    <DockPanel Name="CECMain">
        <Border Name="CECBorder" Classes="CECBorder"> 
        <TextBlock Name="CECText" Classes="CECText BLFontClass" PointerReleased="OnPress"></TextBlock>
        </Border>
    </DockPanel>

</UserControl>
