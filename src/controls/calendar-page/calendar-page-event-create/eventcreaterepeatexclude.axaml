<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
    x:Class="project_main.EventCreateRepeatExclude"
    DockPanel.Dock="Top">


    <Grid Name="ECREMain" Classes="ECREMain" ColumnDefinitions="3*,*">
        <TextBlock Name="ECREText" Classes="BLFontClass ECREText" Grid.Column="0"/>
        <Button Name="ECREDisable" Classes="ECREDisable BUFontClass" Content="Delete" Click="ButtonClick" Grid.Column="1"/>
    </Grid>
    
</UserControl>

