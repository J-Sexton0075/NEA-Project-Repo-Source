<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
    x:Class="project_main.OverviewBlock"
    HorizontalAlignment="Stretch"
    Height="200"
    VerticalAlignment="Top"
    DockPanel.Dock="Top">

    <Border Name="OBBorder" Classes="OBBorder">
        <Grid Name="OBGrid" Classes="OBGrid" RowDefinitions="*,*,4*">
            <TextBlock Name="OBTextName" Classes="BLFontClass OBTextName" Grid.Row="0"/>
            <TextBlock Name="OBTextStat" Classes="BLFontClass OBTextDesc" Grid.Row="1"/>
            <TextBlock Name="OBTextDesc" Classes="BLFontClass OBTextDesc" Grid.Row="2"/> 
        </Grid>
    </Border>
    
</UserControl>

